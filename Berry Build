      "parameters": {
        "jsCode": "// Collect all scraped results and pair with store metadata\nconst allItems = $input.all();\nconst storeUrls = $('Build Scrape URLs').all();\n\nlet combinedContent = '';\nconst storeMetadata = [];\n\nfor (let i = 0; i < allItems.length; i++) {\n  const store = storeUrls[i]?.json || { name: `Store ${i}` };\n  const markdown = allItems[i]?.json?.markdown \n    || allItems[i]?.json?.data?.markdown \n    || allItems[i]?.json?.content\n    || 'No content scraped';\n  \n  storeMetadata.push({\n    name: store.name,\n    slug: store.slug,\n    color: store.color,\n    flyerUrl: store.flyerUrl\n  });\n  \n  // Trim each store's content to avoid hitting AI token limits\n  combinedContent += `\\n\\n=== ${store.name} (${store.url}) ===\\n${markdown.substring(0, 8000)}`;\n}\n\nreturn [{\n  json: {\n    scrapedContent: combinedContent,\n    storeMetadata: storeMetadata,\n    scrapeTimestamp: new Date().toISOString(),\n    storesScraped: storeMetadata.length\n  }\n}];"
      },
      "id": "f9b22efe-2615-4dd7-9870-87a10676e065",
      "name": "Combine Scrape Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3440,
        1072
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse AI response and build final structured data\nconst aiResponse = $input.first().json;\nconst formatNode = $('Combine Scrape Results').first().json;\nconst storeMetadata = formatNode.storeMetadata;\nconst scrapeTimestamp = formatNode.scrapeTimestamp;\n\n// Parse the AI output\nlet parsedPrices;\ntry {\n  const responseText = aiResponse.output?.[0]?.content?.[0]?.text || aiResponse.message?.content || aiResponse.text || aiResponse.content || JSON.stringify(aiResponse);\n\n  const jsonMatch = responseText.match(/\\{[\\s\\S]*\\}/);\n  parsedPrices = JSON.parse(jsonMatch ? jsonMatch[0] : responseText);\n} catch (e) {\n  return [{ json: { error: 'Failed to parse AI response', raw: String(aiResponse).substring(0, 500), message: e.message } }];\n}\n\n// Calculate current week range (Thu-Wed)\nconst now = new Date();\nconst dayOfWeek = now.getDay();\nconst thursday = new Date(now);\nthursday.setDate(now.getDate() - ((dayOfWeek + 3) % 7));\nconst wednesday = new Date(thursday);\nwednesday.setDate(thursday.getDate() + 6);\nconst months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];\nconst weekLabel = `${months[thursday.getMonth()]} ${thursday.getDate()}-${wednesday.getDate()}, ${thursday.getFullYear()}`;\n\nfunction getEmoji(t) {\n  t = t.toLowerCase();\n  if (t.includes('strawberr')) return '🍓';\n  if (t.includes('blueberr')) return '🫐';\n  if (t.includes('blackberr')) return '🍇';\n  if (t.includes('raspberr')) return '🔴';\n  if (t.includes('cranberr')) return '🔴';\n  if (t.includes('mixed')) return '🫐';\n  return '🍓';\n}\n\n// Merge AI-parsed prices with store metadata\nconst stores = (parsedPrices.stores || []).map(aiStore => {\n  const meta = storeMetadata.find(m =>\n    m.name.toLowerCase().replace(/[^a-z]/g, '').includes(aiStore.name.toLowerCase().replace(/[^a-z]/g, '')) ||\n    aiStore.name.toLowerCase().replace(/[^a-z]/g, '').includes(m.name.toLowerCase().replace(/[^a-z]/g, ''))\n  ) || { name: aiStore.name, slug: aiStore.name.toLowerCase().replace(/[^a-z0-9]/g, ''), color: '#666', flyerUrl: '' };\n\n  return {\n    name: meta.name,\n    slug: meta.slug,\n    color: meta.color,\n    flyerUrl: meta.flyerUrl,\n    berries: (aiStore.berries || []).map(b => ({\n      type: b.type,\n      emoji: getEmoji(b.type),\n      unit: b.unit || 'each',\n      price: Number(b.price),\n      wasPrice: b.wasPrice ? Number(b.wasPrice) : null,\n      onSale: Boolean(b.onSale),\n      source: b.source || 'website'\n    }))\n  };\n}).filter(s => s.slug !== 'rfd' && s.slug !== 'redflagdeals');\n\n// Find best deal\nlet bestDeal = null;\nlet lowestPrice = Infinity;\nfor (const store of stores) {\n  for (const berry of store.berries) {\n    if (berry.price > 0 && berry.price < lowestPrice) {\n      lowestPrice = berry.price;\n      bestDeal = {\n        store: store.name,\n        berry: berry.type,\n        emoji: berry.emoji,\n        price: berry.price,\n        unit: berry.unit,\n        savings: berry.wasPrice\n          ? `Save $${(berry.wasPrice - berry.price).toFixed(2)}`\n          : 'Cheapest option this week'\n      };\n    }\n  }\n}\n\nreturn [{ json: {\n  week: weekLabel,\n  lastUpdated: scrapeTimestamp,\n  stores,\n  bestDeal,\n  totalPricesTracked: stores.reduce((sum, s) => sum + s.berries.length, 0)\n}}];"
      },
