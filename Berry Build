        "jsCode": "// Store current week + append to history using n8n Data Table\nconst currentData = $input.first().json;\nconst now = new Date();\n\nreturn [{ json: {\n  week: currentData.week,\n  last_updated: currentData.lastUpdated,\n  stores_json: JSON.stringify(currentData.stores),\n  best_deal_json: JSON.stringify(currentData.bestDeal),\n  total_prices_tracked: currentData.totalPricesTracked,\n  is_current: 'true',\n  created_at: now.toISOString()\n}}];"
