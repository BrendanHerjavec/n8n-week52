      "parameters": {
        "jsCode": "// Define all store URLs to scrape for berry prices\n// Using flyer aggregator sites for better scraping reliability\nconst stores = [\n  {\n    url: 'https://www.loblaws.ca/en/food/fruits-vegetables/fresh-fruits/berries-cherries/c/29725',\n    name: 'Loblaws',\n    slug: 'loblaws',\n    color: '#DC2626',\n    flyerUrl: 'https://www.loblaws.ca/en/food/fruits-vegetables/fresh-fruits/berries-cherries/c/29725'\n  },\n  {\n    url: 'https://www.flyers-on-line.com/freshco/ontario',\n    name: 'FreshCo',\n    slug: 'freshco',\n    color: '#16A34A',\n    flyerUrl: 'https://www.freshco.com/flyer'\n  },\n  {\n    url: 'https://www.flyerca.com/longos-sales/',\n    name: \"Longo's\",\n    slug: 'longos',\n    color: '#7F1D1D',\n    flyerUrl: 'https://www.longos.com/flyers'\n  },\n  {\n    url: 'https://www.nofrills.ca/en/food/fruits-vegetables/fresh-fruits/berries-cherries/c/29725',\n    name: 'No Frills',\n    slug: 'nofrills',\n    color: '#FFD700',\n    flyerUrl: 'https://www.nofrills.ca/en/food/fruits-vegetables/fresh-fruits/berries-cherries/c/29725'\n  },\n  {\n    url: 'https://www.flyers-on-line.com/food-basics',\n    name: 'Food Basics',\n    slug: 'foodbasics',\n    color: '#FF6B00',\n    flyerUrl: 'https://www.foodbasics.ca/flyer'\n  },\n  {\n    url: 'https://www.flyers-on-line.com/walmart/ontario',\n    name: 'Walmart',\n    slug: 'walmart',\n    color: '#0071CE',\n    flyerUrl: 'https://www.walmart.ca/browse/fruits-vegetables/berries/10019-20002-31000'\n  },\n  {\n    url: 'https://www.redflagdeals.com/flyers/search/?q=berries',\n    name: 'RedFlagDeals',\n    slug: 'rfd',\n    color: '#CC0000',\n    flyerUrl: 'https://www.redflagdeals.com/flyers/'\n  }\n];\n\nreturn stores.map(store => ({ json: store }));"
