    {
      "parameters": {
        "jsCode": "// Check berry alerts using data from the data table\nconst currentData = $('Build Final Price Data').first().json;\nconst subscriberItems = $('Get Subscribers From Table').all();\n\nif (!subscriberItems || subscriberItems.length === 0 || !subscriberItems[0].json.email) {\n  return [{ json: { message: 'No subscribers yet', alertsSent: 0 } }];\n}\n\nconst subscribers = subscriberItems.map(item => ({\n  email: item.json.email,\n  berryTypes: JSON.parse(item.json.berry_types_json || '[]'),\n  maxPrice: Number(item.json.max_price)\n}));\n\nconst alerts = [];\nfor (const sub of subscribers) {\n  for (const store of currentData.stores) {\n    for (const berry of store.berries) {\n      const match = sub.berryTypes.some(bt =>\n        berry.type.toLowerCase().includes(bt.toLowerCase())\n      );\n      if (match && berry.price <= sub.maxPrice) {\n        alerts.push({\n          email: sub.email,\n          berry: berry.type,\n          emoji: berry.emoji,\n          price: berry.price,\n          unit: berry.unit,\n          store: store.name,\n          maxPrice: sub.maxPrice\n        });\n      }\n    }\n  }\n}\n\nif (alerts.length === 0) {\n  return [{ json: { message: 'No alerts triggered this week', subscriberCount: subscribers.length } }];\n}\n\nreturn alerts.map(a => ({ json: a }));"
      },
